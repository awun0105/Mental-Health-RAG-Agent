# ==========================================
# 1. Môi trường & Biến bảo mật (SỐNG CÒN)
# ==========================================
.venv/
.env
.env.*
!.env.example
.archive
# ==========================================
# 2. Bộ nhớ đệm (Cache) của Python & Công cụ
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ==========================================
# 3. Notebooks (Vì bạn có thư mục notebooks/)
# ==========================================
.ipynb_checkpoints/

# ==========================================
# 4. Thư mục cá nhân & Tài liệu nháp
# ==========================================

docs/_notes/[0\]project_history.md

# ==========================================
# 5. Hệ điều hành & IDE (Code Editor)
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
.cursorignore
.cursorindexingignore

# ==========================================
# 6. Dữ liệu (Tránh đẩy file PDF, DB nặng lên Git)
# ==========================================
backend/data/raw/*
backend/data/processed/*
!backend/data/raw/.gitkeep
!backend/data/processed/.gitkeep



GEMINI.md
docs/.plan/*
!docs/.plan/MASTER_PLAN.md
!docs/.plan/MILESTONE1.md
!docs/.plan/MILESTONE2.md
!docs/.plan/README.md

docs/checkpoints/*

# Harness durable layer
harness.db
harness.db-wal
harness.db-shm
scripts/bin/harness-cli
scripts/bin/harness-cli.exe

# React frontend
web/node_modules/
web/dist/
web/*.tsbuildinfo
web/vite.config.js
web/vite.config.d.ts
